#!/usr/bin/env bash
# Admin anlegen oder Passwort zurücksetzen (z. B. wenn vergessen).
#   urlaubskasse-admin <benutzername>
set -euo pipefail
SRC="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ -z "${1:-}" ]; then echo "Aufruf: urlaubskasse-admin <benutzername>"; exit 1; fi
if [ "$(id -u)" -ne 0 ]; then echo "Bitte als root ausführen."; exit 1; fi
runuser -u urlaubskasse -- env URLAUB_DATA=/var/lib/urlaubskasse python3 "$SRC/app.py" --admin "$1"
